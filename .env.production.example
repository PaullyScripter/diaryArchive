# ─── Production secrets ─────────────────────────────────────────────────────────
# Copy to .env.production (gitignored) and fill every value. The prod compose
# file fails to start if any required value is missing or a weak/dev value is
# detected.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be >= 32 chars and NOT in the known-weak dev set.
SECRET_KEY=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be exactly 64 hex chars and not all zeros.
EMAIL_ENCRYPTION_KEY=
DEBUG=false

# --- MongoDB ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

# --- Redis ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
REDIS_PASSWORD=

# --- Meilisearch ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
# Must not equal 'dev-master-key'.
MEILI_MASTER_KEY=

# --- MinIO ---
# Must not equal 'minioadmin'. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- CORS (frontend origin) ---
CORS_ORIGINS=["https://diaryarchive.com"]
