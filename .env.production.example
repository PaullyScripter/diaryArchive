# ─── Production secrets ─────────────────────────────────────────────────────────
# Copy to .env.production (gitignored) and fill every value. The prod compose
# file fails to start if any required value is missing or a weak/dev value is
# detected.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be >= 32 chars and NOT in the known-weak dev set.
SECRET_KEY=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be exactly 64 hex chars and not all zeros.
EMAIL_ENCRYPTION_KEY=
DEBUG=false

# --- Backup encryption ---
# Authenticated encryption passphrase used to encrypt MongoDB/MinIO backups at rest.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be >= 32 chars. Do NOT lose it: backups cannot be restored without it.
BACKUP_ENCRYPTION_KEY=
# Retention (counts kept). 0 disables that class.
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=6

# --- MongoDB ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
# Least-privilege application account; the production overlay creates it with
# readWrite + dbAdmin on the diaryarchive database.
MONGO_APP_USER=
MONGO_APP_PASSWORD=

# --- Redis ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
REDIS_PASSWORD=

# --- Meilisearch ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
# Must not equal 'dev-master-key'.
MEILI_MASTER_KEY=

# --- MinIO ---
# Must not equal 'minioadmin'. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Optional public media base URL for immutable public objects. When unset,
# media uses the authorization-aware application proxy.
PUBLIC_MEDIA_BASE_URL=

# --- CORS (frontend origin) ---
CORS_ORIGINS=["https://diaryarchive.com"]

# --- Deployment metadata ---
# Set by CI/CD pipeline or deploy.sh. Used in health endpoint response.
APP_VERSION=0.1.0
COMMIT_HASH=
DEPLOYED_AT=

# --- Monitoring ---
# Grafana admin password. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(16))"
GRAFANA_PASSWORD=

# --- Redis memory limit ---
# Max memory for Redis. Eviction policy is allkeys-lru.
REDIS_MAXMEMORY=128mb
